# mincc 环境变量模板
# 复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，不会提交到仓库

# ============ 模型 Provider 配置 ============
# 支持的 provider：claude | openai | deepseek
LLM_PROVIDER=openai

# 模型名，按 provider 而异：
#   claude:   claude-sonnet-4-5 / claude-opus-4-7 / claude-haiku-4-5
#   openai:   gpt-4o-mini / gpt-4o
#   deepseek: deepseek-chat / deepseek-reasoner
LLM_MODEL=gpt-4o-mini

# API Key（必填）
LLM_API_KEY=

# Base URL（可选）：
#   claude:   留空走 anthropic 官方端点
#   openai:   留空走 openai 官方端点；自部署 OpenAI 兼容服务可在此覆盖
#   deepseek: 留空默认走 https://api.deepseek.com/v1
LLM_BASE_URL=

# 采样温度，0 为最确定性输出
LLM_TEMPERATURE=0
