# mincc 环境变量模板
# 复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，不会提交到仓库

# ============ 模型 Provider 配置 ============
# 支持的 provider：anthropic | openai
# 国内模型（DeepSeek / 通义 / 智谱 / Moonshot 等）和自部署模型
# 通常都兼容 OpenAI 协议，统一使用 LLM_PROVIDER=openai + 自定义 LLM_BASE_URL
LLM_PROVIDER=openai

# 模型名，按 provider 而异：
#   anthropic:  claude-sonnet-4-5 / claude-opus-4-7 / claude-haiku-4-5
#   openai:     gpt-4o-mini / gpt-4o
#   deepseek:   deepseek-chat / deepseek-reasoner
#   通义:       qwen-plus / qwen-max
#   智谱:       glm-4
LLM_MODEL=gpt-4o-mini

# API Key（必填）
LLM_API_KEY=

# Base URL（可选）：
#   留空走官方端点；走 OpenAI 兼容接口的国内/自部署模型在此填入
#   DeepSeek:  https://api.deepseek.com/v1
#   通义:      https://dashscope.aliyuncs.com/compatible-mode/v1
#   智谱:      https://open.bigmodel.cn/api/paas/v4
#   本地 Ollama: http://localhost:11434/v1
LLM_BASE_URL=

# 采样温度，0 为最确定性输出
LLM_TEMPERATURE=0
